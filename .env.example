# ==============================================================================
# HackHub — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env for local testing or set these variables in your
# cloud provider dashboard (e.g. Render, Railway, Heroku, Docker).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Option A: Direct Connection (Port 5432)
# DB_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=your_supabase_db_password

# Option B: Supabase Session Pooler (IPv4 compatible, Port 5432) — RECOMMENDED FOR RENDER
# DB_URL=jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.[YOUR-PROJECT-REF]
# DB_PASSWORD=your_supabase_db_password

# Option C: Supabase Transaction Pooler (Port 6543)
# Note: Add prepareThreshold=0 when using transaction pooler with Spring Boot
# DB_URL=jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
# DB_USERNAME=postgres.[YOUR-PROJECT-REF]
# DB_PASSWORD=your_supabase_db_password

DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 2. Server & Security Configuration
# ------------------------------------------------------------------------------
PORT=8085
APP_URL=https://hackhub-h1uf.onrender.com

# 256-bit (64-character hex) Secret Key for signing JWT tokens
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250655368566D5971

# ------------------------------------------------------------------------------
# 3. Email Notification Configuration (Optional)
# ------------------------------------------------------------------------------
# Brevo API (Transactional Email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=libineshr7@gmail.com
BREVO_SENDER_NAME=HackHub Security Team

# Fallback Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
